{
  "format": "uartix-plugin",
  "schemaVersion": 3,
  "id": "uartix.yolo",
  "version": "0.3.4",
  "name": "YOLO 训练工作台",
  "description": "数据集拆分 → 训练 → 评估 → 部署收在一个面板里：读工作区的 config.yaml 当基准，参数面直接由装好的 ultralytics 给出（不做一份会过期的白名单），每次实验在 train_runs/ 落一份完整 yaml——面板能点的，命令行也跑得起来。",
  "author": "uartix",
  "homepage": "https://github.com/Tanixs/uartix.yolo",
  "license": "MIT",
  "main": "main.mjs",
  "activation": [
    "onPanel:train",
    "onCommand:yolo.status",
    "onCommand:yolo.stop"
  ],
  "permissions": {
    "fs": {
      "read": [
        "$WS",
        "$EXT:deploy"
      ],
      "write": [
        "$WS/.uartix",
        "$WS/annotations",
        "$WS/datasets",
        "$WS/logs",
        "$WS/models",
        "$WS/runs",
        "$WS/train_runs"
      ]
    },
    "process": {
      "spawn": [
        "python"
      ]
    },
    "ui": {
      "panel": true
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "train",
        "title": "YOLO 训练",
        "entry": "panel.html"
      }
    ],
    "commands": [
      {
        "id": "yolo.status",
        "title": "YOLO：查看训练现状"
      },
      {
        "id": "yolo.stop",
        "title": "YOLO：停止当前任务"
      }
    ]
  }
}

{
  "format": "uartix-plugin",
  "schemaVersion": 3,
  "id": "uartix.yolo",
  "version": "0.1.0",
  "name": "YOLO 训练工作台",
  "description": "数据集拆分 → 训练 → 部署收在一个面板里：读工作区的 config.yaml 当基准，参数在面板里改，起 python 子进程把日志和进度实时拉回来。",
  "author": "uartix",
  "license": "MIT",
  "main": "main.mjs",
  "activation": ["onPanel:train"],
  "permissions": {
    "fs": {
      "read": ["$WS"],
      "write": ["$WS/.uartix", "$WS/datasets", "$WS/runs", "$WS/logs"]
    },
    "process": { "spawn": ["python"] },
    "ui": { "panel": true }
  },
  "contributes": {
    "panels": [{ "id": "train", "title": "YOLO 训练", "entry": "panel.html" }]
  }
}

{
  "format": "uartix-plugin",
  "schemaVersion": 2,
  "id": "uartix.theme.fluent-blue",
  "version": "1.1.0",
  "name": "流利蓝 · 全量",
  "desc": "Fluent Design 组件层主题：按钮/输入/页签/开关/滑杆/菜单/对话框/卡片/导轨的默认·hover·active·focus·disabled 五态，加两条标题栏与浮层亚克力。",
  "hostApi": "^1.0",
  "capabilities": [
    "theme.tokens"
  ],
  "contributions": {
    "themes": [
      {
        "id": "main",
        "entry": "main.json",
        "name": "流利蓝 · 全量"
      }
    ]
  },
  "artifacts": {
    "main.json": {
      "kind": "theme",
      "scheme": "light",
      "vars": {
        "--bg": "#faf9f7",
        "--bg-panel": "#ffffff",
        "--bg-inset": "#ebe9e7",
        "--bg-titlebar": "#edebe9",
        "--border": "#c8c6c4",
        "--border-soft": "#e1dfdd",
        "--text": "#201f1e",
        "--text-dim": "#605e5c",
        "--accent": "#005a9e",
        "--on-accent": "#ffffff",
        "--accent-soft": "color-mix(in srgb, var(--accent) 12%, transparent)",
        "--danger": "#c50f1f",
        "--warn": "#8a6d1f",
        "--ok": "#0f7a2f",
        "--shadow": "0 0.6px 1.8px rgba(0, 0, 0, 0.1), 0 3.2px 7.2px rgba(0, 0, 0, 0.13)",
        "--scrollbar": "#c9c7c5",
        "--scrollbar-hover": "#a19f9d",
        "--radius-s": "3px",
        "--radius-m": "4px",
        "--radius-l": "6px",
        "--radius-xl": "8px",
        "--ease": "cubic-bezier(0, 0, 0.2, 1)",
        "--ring": "color-mix(in srgb, var(--accent) 92%, transparent)",
        "--k-send": "#0b6ec7",
        "--k-wait": "#9a6700",
        "--k-frame": "#7a3fd0",
        "--k-assert": "#0f7a2f",
        "--k-note": "#bc4c00",
        "--k-logic": "#5e3d99",
        "--k-group": "#0f6f7a",
        "--k-warn-line": "#a04a05",
        "--warn-fg": "#8f6308"
      },
      "cssFile": "components.css",
      "assets": [
        {
          "id": "acrylic-noise",
          "mime": "image/svg+xml",
          "data": ""
        }
      ]
    }
  },
  "provenance": {
    "createdBy": "user",
    "reviewed": false
  }
}

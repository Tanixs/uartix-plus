{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uartix-Plus",
  "version": "0.3.2",
  "identifier": "com.uartix.plus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Uartix+",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Tanixs/uartix-plus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNzYyNDNBNTgzMDZEQjMKUldTemJUQllPaVIyK3c0SkQ0dFVzVVQyU3NqVlVPYWVUZXJXY211T2lRQjdrcmZ1VEdhVDdyMXcK"
    }
  }
}

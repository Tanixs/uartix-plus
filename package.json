{
  "name": "uartix-plus",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "build:seq": "node scripts/build-seq-cli.mjs",
    "build:mcp": "node scripts/build-mcp-cli.mjs",
    "build:plugin-cli": "node scripts/build-plugin-cli.mjs",
    "plugin": "node dist-cli/uartix-plugin.cjs",
    "mcp:e2e": "node scripts/mcp-e2e.mjs",
    "check:theme": "node .tools/check-contrast.cjs",
    "check:vars": "node .tools/check-undeclared-vars.cjs",
    "check:style": "node .tools/check-style.cjs",
    "check:aria": "node .tools/check-aria.cjs",
    "check:motion": "node .tools/check-motion.cjs",
    "check:cycles": "node .tools/check-import-cycles.cjs",
    "check:all": "node .tools/check-contrast.cjs && node .tools/check-undeclared-vars.cjs && node .tools/check-style.cjs && node .tools/check-aria.cjs && node .tools/check-motion.cjs && node .tools/check-import-cycles.cjs && node .tools/check-commands-registered.cjs",
    "market:img": "node scripts/gen-market-img.mjs",
    "market:gen": "node scripts/gen-market-img.mjs && node scripts/gen-market-index.mjs",
    "market:check": "node scripts/gen-market-img.mjs --check",
    "market:validate": "node dist-cli/uartix-plugin.cjs validate",
    "check:commands": "node .tools/check-commands-registered.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  }
}
